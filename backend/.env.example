# Database URL (SQLite default, or PostgreSQL for production)
DATABASE_URL=sqlite:///./kirana.db
# DATABASE_URL=postgresql://user:password@localhost:5432/kirana

# OpenAI API Key (required for real AI mode)
OPENAI_API_KEY=your-openai-api-key-here

# LLM Model
LLM_MODEL=gpt-4-turbo-preview

# STT Provider
STT_PROVIDER=whisper

# Set to "true" to use mock AI (no API calls, for development/demo)
USE_MOCK_AI=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
